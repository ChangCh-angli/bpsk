set_property -dict {PACKAGE_PIN AV18   IOSTANDARD LVCMOS18} [get_ports tx_data_q[12]]

set_property C_CLK_INPUT_FREQ_HZ 600000000 [get_debug_cores dbg_hub]
set_property C_ENABLE_CLK_DIVIDER false [get_debug_cores dbg_hub]
set_property C_USER_SCAN_CHAIN 1 [get_debug_cores dbg_hub]